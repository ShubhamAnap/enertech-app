# ==============================================================================
# COOLIFY PRODUCTION ENVIRONMENT SECRETS TEMPLATE (.env.example)
# ==============================================================================
# Copy these key names and values into Coolify's Environment Variables panel.
# Never commit populated production keys to Git.

# --- Required API runtime settings ---
SUPABASE_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Temporary first-login bootstrap; remove after a super-admin account is active.
BOOTSTRAP_SUPER_ADMIN_UIDS=
API_CORS_ORIGINS=https://cms.yourdomain.com

# --- Optional: only if using CMS → WordPress import ---
WORDPRESS_API_BASE_URL=https://enertechups.com/wp-json
WORDPRESS_CONSUMER_KEY=
WORDPRESS_CONSUMER_SECRET=

# --- Optional: only if publishing the hosted chat widget ---
CHAT_ALLOWED_HOSTS=enertechups.cloud
CHAT_WIDGET_SCRIPT_URL=https://enertechups.cloud/widget.js
CHAT_WIDGET_PUBLIC_KEY=

# --- Required public CMS build settings ---
# These are baked into the Next.js static bundle during container build:
NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com/api/v1
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
