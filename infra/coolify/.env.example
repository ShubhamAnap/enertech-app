# ==============================================================================
# COOLIFY PRODUCTION ENVIRONMENT SECRETS TEMPLATE (.env.example)
# ==============================================================================
# Copy these key names and values into Coolify's Environment Variables panel.
# Never commit populated production keys to Git.

# --- Backend API Container Runtime Secrets ---
APP_ENV=production
APP_NAME=EnerTech Customer Platform API
SUPABASE_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_MEDIA_BUCKET=enertech-public
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
BOOTSTRAP_SUPER_ADMIN_UIDS=
API_CORS_ORIGINS=https://cms.yourdomain.com

# --- Optional WooCommerce Integration ---
WORDPRESS_API_BASE_URL=https://enertechups.com/wp-json
WORDPRESS_PRODUCTS_PATH=wc/v3/products
WORDPRESS_CATEGORIES_PATH=wc/v3/products/categories
WORDPRESS_STORE_PRODUCTS_PATH=wc/store/v1/products
WORDPRESS_DOCUMENTS_PATH=wp/v2/media
WORDPRESS_CONSUMER_KEY=
WORDPRESS_CONSUMER_SECRET=
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
WORDPRESS_SOURCE_ID_FIELD=id
WORDPRESS_SOURCE_SLUG_FIELD=slug
WORDPRESS_SOURCE_TITLE_FIELD=name
WORDPRESS_SOURCE_SUMMARY_FIELD=short_description
WORDPRESS_SOURCE_MODEL_FIELD=sku
WORDPRESS_SOURCE_DESCRIPTION_FIELD=description
WORDPRESS_SOURCE_IMAGE_FIELD=images.0.src
WORDPRESS_SOURCE_GALLERY_FIELD=images
WORDPRESS_SOURCE_APPLICATIONS_FIELD=
WORDPRESS_SOURCE_FEATURES_FIELD=
WORDPRESS_SOURCE_SPECIFICATIONS_FIELD=attributes

# --- Support Chat ---
CHAT_ALLOWED_HOSTS=enertechups.cloud
CHAT_WIDGET_SCRIPT_URL=https://enertechups.cloud/widget.js
CHAT_WIDGET_PUBLIC_KEY=

# --- Admin CMS Container Build Arguments ---
# These are baked into the Next.js static bundle during container build:
NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com/api/v1
ALLOW_HTTP_TEST_API=false
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
